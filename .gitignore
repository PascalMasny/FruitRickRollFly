# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
web/dist/

# Audio corpus and derived features: large, rebuildable, not ours to redistribute
data/audio/*
!data/audio/.gitkeep
data/features/*
!data/features/.gitkeep
data/video/*
!data/video/.gitkeep
data/features-eye/*
!data/features-eye/.gitkeep
data/cache/*
!data/cache/.gitkeep

# Corrections and notes are the user's, and the merged manifest is derived
data/corrections.jsonl
data/notes.md
data/manifest-with-corrections.json
data/active-models.json

# Runtime
.DS_Store
*.log
